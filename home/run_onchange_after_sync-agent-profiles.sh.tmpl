#!/usr/bin/env bash
set -euo pipefail

# Every coding agent gets the same skills and instructions out of ~/.agent-shared,
# linked in under whatever name that agent expects.
shared="$HOME/.agent-shared"

# Entries are <link name in the agent's config dir>=<entry in $shared>.
claude_links=(
  "skills=skills"
  "CLAUDE.md=AGENTS.md"
  "statusline-command.sh=statusline-command.sh"
  "settings.json=claude-settings.json"
)

link_into() {
  local dir="$1"
  shift
  mkdir -p "$dir"
  for pair in "$@"; do
    local link="$dir/${pair%%=*}"
    local target="$shared/${pair#*=}"
    if [[ -e "$link" && ! -L "$link" ]]; then
      local backup="$link.pre-chezmoi.$(date +%Y%m%d%H%M%S).bak"
      mv "$link" "$backup"
      echo "backed up $link -> $backup"
    fi
    ln -sfn "$target" "$link"
  done
  echo "synced $dir"
}

profiles=({{ range .claude_profiles }}{{ . | quote }} {{ end }})
bin="$HOME/.local/bin"
mkdir -p "$bin"
link_launcher() {
  ln -sfn "$bin/claude-profile" "$bin/claude-$1"
  echo "synced $bin/claude-$1"
}

# The dispatcher resolves its own name by prefix, so an initial-only link is
# worth making whenever no other profile starts with the same letter.
unique_initial() {
  local initial="${1:0:1}" seen=0
  for q in "${profiles[@]}"; do
    [[ "${q:0:1}" == "$initial" ]] && seen=$((seen + 1))
  done
  [[ $seen -eq 1 ]]
}

for p in "${profiles[@]}"; do
  link_into "$HOME/.claude-$p" "${claude_links[@]}"
  link_launcher "$p"
  unique_initial "$p" && link_launcher "${p:0:1}"
done
