{{- /* Refresh externals on demand with: chezmoi apply --refresh-externals */ -}}
{{ template "mattpocock-skills-externals" . }}
{{ template "chrome-devtools-skills-externals" . }}

# The skill is the whole repo root upstream, but its .gitattributes
# export-ignores everything that isn't skill payload, so the archive arrives
# clean apart from an empty dist/.
[".agent-shared/skills/ux-writing-skill"]
    type = "archive"
    url = "https://github.com/content-designer/ux-writing-skill/archive/refs/heads/main.tar.gz"
    exact = true
    stripComponents = 1
    exclude = ["ux-writing-skill-main/dist"]
    refreshPeriod = "168h"

[".agent-shared/skills/unslop"]
    type = "archive"
    url = "https://github.com/backnotprop/pstack/archive/refs/heads/main.tar.gz"
    exact = true
    stripComponents = 3
    include = ["pstack-main/skills/unslop/**"]
    refreshPeriod = "168h"

[".agent-shared/skills/poteto-mode"]
    type = "archive"
    url = "https://github.com/cursor/plugins/archive/refs/heads/main.tar.gz"
    exact = true
    stripComponents = 4
    include = ["plugins-main/pstack/skills/poteto-mode/[!S]*/**"]
    refreshPeriod = "168h"

# Cursor's SKILL.md names the skill with a display label, but Agent Skills names
# accept only lowercase slugs. An include beats an exclude in chezmoi, so the
# archive's pattern above is what keeps its SKILL.md out.
[".agent-shared/skills/poteto-mode/SKILL.md"]
    type = "file"
    url = "https://raw.githubusercontent.com/cursor/plugins/main/pstack/skills/poteto-mode/SKILL.md"
    filter.command = "sed"
    filter.args = ["s/^name: Poteto Mode$/name: poteto-mode/"]
    refreshPeriod = "168h"
