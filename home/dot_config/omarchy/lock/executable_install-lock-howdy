#!/bin/bash

# Installs the Howdy-enabled copies of omarchy.lock's QML over the packaged ones.
# omarchy.lock has no extension point for a third PAM backend, so the only way in
# is to replace the files; `omarchy update` reinstalls the package and undoes it.
#
# Refuses when the packaged file is neither the upstream version these copies were
# derived from nor a copy already installed, because that means upstream changed
# and these copies would silently revert its changes.

set -euo pipefail

src="$(cd "$(dirname "$0")" && pwd)"
dest="${OMARCHY_PATH:-/usr/share/omarchy}/shell/plugins/lock"
changed=0

for name in Service.qml LockView.qml; do
  want=$(sha256sum "$src/$name" | cut -d' ' -f1)
  have=$(sha256sum "$dest/$name" 2>/dev/null | cut -d' ' -f1 || echo missing)
  base=$(awk -v n="$name" '$2 == n {print $1}' "$src/baseline.sha256")

  [ "$have" = "$want" ] && continue

  if [ "$have" != "$base" ]; then
    echo "$name: packaged copy is neither upstream $base nor ours; refusing" >&2
    exit 1
  fi

  sudo install -m 644 "$src/$name" "$dest/$name"
  changed=1
done

[ "$changed" = 1 ] || exit 0

echo "lock plugin patched for Howdy"
