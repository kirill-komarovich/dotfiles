{{/* Ghostty defers config-file includes until after the including file, so
     anything set next to the include loses to it. These load from a trailing
     include instead, which is the only way to beat omarchy's packaged config. */ -}}
{{/* Repeated font-family appends a fallback, so the list needs clearing first.
     monospace resolves through fontconfig, which is where omarchy-font-set
     writes the chosen family. */ -}}
font-family = ""
font-family = "monospace"
font-size = 10
shell-integration = fish

window-decoration = none
window-padding-x = 0
window-padding-y = 0

{{/* initial-command only reaches the first surface, so every later window fell
     back to $SHELL, which is whatever the session that started Hyprland had. */ -}}
command = /usr/bin/fish
initial-command = /usr/bin/fish -l -c "herdr"
