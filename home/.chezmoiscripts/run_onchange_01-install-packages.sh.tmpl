#!/bin/bash

set -eufo pipefail

{{- $profile := includeTemplate "profile" . }}

{{ $packages := list
  "git"
  "curl"
-}}

{{ $sudo := "sudo " -}}
{{ if eq .chezmoi.username "root" -}}
{{   $sudo = "" -}}
{{ end -}}

{{ if eq $profile "mac" -}}

/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

brew install {{ $packages | join " " }}
brew install fish

{{ else if eq $profile "omarchy" -}}

{{ $arch_packages := concat $packages (list
  "base-devel"
  "fish"
  "ripgrep"
  "tmux"
  "wl-clipboard"
) -}}

{{/* mise builds erlang, elixir and ruby from source, so their headers ship here. */ -}}
{{ $arch_build_deps := list
  "gmp"
  "libffi"
  "libxslt"
  "libyaml"
  "ncurses"
  "openssl"
  "readline"
  "unixodbc"
  "unzip"
  "wxwidgets-gtk3"
  "zlib"
-}}

packages=({{ concat $arch_packages $arch_build_deps | join " " }})

if ! {{ $sudo }}pacman -S --needed --noconfirm "${packages[@]}"; then
  # A stale sync db asks the mirror for versions it has already dropped.
  {{ $sudo }}pacman -Sy --noconfirm
  {{ $sudo }}pacman -S --needed --noconfirm "${packages[@]}"
fi

{{ else -}}

{{ $repos := list
  "ppa:git-core/ppa"
-}}

{{ $sudo }}add-apt-repository -y {{ $repos | join " " }}
{{ $sudo }}apt update
{{ $sudo }}apt install -y {{ $packages | join " " }}

{{ end -}}
