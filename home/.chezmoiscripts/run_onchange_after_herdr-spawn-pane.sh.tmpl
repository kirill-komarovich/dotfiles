#!/bin/bash

set -eufo pipefail

# Bootstrap and repair only, same deal as the herdr-dev script next door: a
# run_onchange_ script re-runs only when its own rendered content changes, and
# ~/.local/bin/herdr-spawn-pane is a symlink, so a manual
# `mise exec -- cargo build --release` goes live without an apply.

command -v mise >/dev/null || exit 0

crate={{ .chezmoi.sourceDir | dir }}/herdr-spawn-pane

cd "$crate"

# The source tree is shared with other machines, so keep build output out of it.
export CARGO_TARGET_DIR="$HOME/.cache/cargo-target/herdr-spawn-pane"

# mise refuses to read a config file it has not been told to trust.
mise trust
mise install -y
mise exec -- cargo build --release

