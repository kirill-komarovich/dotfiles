{{ $profile := includeTemplate "profile" . -}}
{{ if eq $profile "omarchy" -}}
{{/* Omarchy's packaged config carries the live theme include, the CSI-u
     keybinds and the hyprland async-backend workaround. Ours only overrides
     behaviour on top, so `omarchy theme set` keeps working. */ -}}
config-file = ?"/usr/share/omarchy/config/ghostty/config"
config-file = "~/.config/ghostty/overrides"

{{ else -}}
{{/* Ghostty picks by the system's appearance, and Corgi follows the theme it
     picks, its [theme.dark] or [theme.light] over it. */ -}}
theme = dark:local-dark,light:local-light

# https://github.com/ryanoasis/nerd-fonts/tree/master/patched-fonts/DroidSansMono
font-family = "DroidSansM Nerd Font Mono"
font-size = 16

shell-integration = fish

initial-command = /opt/homebrew/bin/fish -l -c "herdr"
window-decoration = none

{{/* herdr's splits rather than ghostty's, as Corgi binds them: herdr's prefix,
     ctrl+space, is a NUL on the wire, then its split key. */ -}}
keybind = cmd+d=text:\x00\\
keybind = ctrl+cmd+d=text:\x00-
{{ end -}}
