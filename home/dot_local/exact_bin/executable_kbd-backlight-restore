#!/bin/bash

set -euo pipefail

led=""
for candidate in /sys/class/leds/*kbd_backlight; do
  [ -e "$candidate" ] || continue
  led=$(basename "$candidate")
  break
done
[ -n "$led" ] || exit 0

brightness=/sys/class/leds/$led/brightness
session=$(loginctl --value show-user "$(id -un)" -p Display)
[ -n "$session" ] || exit 0

export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}

# The sysfs file is root-owned and this user is not in video, so the write has
# to go through logind, which grants it to whoever holds the active session.
path=$(busctl --json=short call org.freedesktop.login1 /org/freedesktop/login1 \
  org.freedesktop.login1.Manager GetSession s "$session" |
  sed 's/.*"\(\/org\/freedesktop\/login1\/session\/[^"]*\)".*/\1/')

# Omarchy locks through an ext-session-lock in the compositor, which logind never
# hears about, so LockedHint stays "no" throughout and cannot be used here.
locked() {
  [ "$(omarchy-shell lock isLocked 2>/dev/null)" = true ]
}

last=$(cat "$brightness")
was_locked=no

while :; do
  if locked; then
    now_locked=yes
  else
    now_locked=no
  fi

  current=$(cat "$brightness")

  if [ "$now_locked" = no ]; then
    if [ "$current" -gt 0 ]; then
      last=$current
    elif [ "$was_locked" = yes ] && [ "$last" -gt 0 ]; then
      busctl call org.freedesktop.login1 "$path" org.freedesktop.login1.Session \
        SetBrightness ssu leds "$led" "$last"
    fi
  fi

  was_locked=$now_locked
  sleep 2
done
