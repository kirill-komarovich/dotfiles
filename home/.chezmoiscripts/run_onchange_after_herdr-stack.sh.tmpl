#!/bin/bash

set -eufo pipefail

# herdr has no `plugin update`: bumping this changes the script, which is what
# makes a run_onchange_ script run again and reinstall.
version=0.0.6
repo=kirill-komarovich/herdr-stack

command -v mise >/dev/null || exit 0
mise which herdr >/dev/null 2>&1 || exit 0

herdr() {
  mise exec -- herdr "$@"
}

# An install refuses to replace a local link, and herdr-dev is this plugin's id
# from before its rename, left pointing at a checkout that is gone.
for id in herdr-stack herdr-dev; do
  if herdr plugin list | grep -q "^- $id .*\[local:"; then
    herdr plugin unlink "$id"
  fi
done

herdr plugin install "$repo" --ref "v$version" --yes

# The checkout's dir name carries a hash herdr derives from the repo, so it is
# found rather than spelled: herdr 0.9.5 keeps one per generation under
# github-installations, marking each in use until it clears them (the newest
# mark is the current one), older herdr one under github.
# symlink_herdr-stack.tmpl finds it the same way, but only from the next apply,
# so the first one links it here.
in_use=$(find "$HOME/.config/herdr/plugins/github-installations" -mindepth 3 -maxdepth 3 -name .in-use -path '*/herdr-stack-*' -exec ls -t {} + 2>/dev/null | head -n 1 || true)
if [[ -n $in_use ]]; then
  checkout=$(dirname "$in_use")/checkout
else
  checkout=$(find "$HOME/.config/herdr/plugins/github" -maxdepth 1 -name 'herdr-stack-*' -print -quit)
fi
mkdir -p "$HOME/.local/bin"
ln -sfn "$checkout/target/release/herdr-stack" "$HOME/.local/bin/herdr-stack"

skills="$HOME/.agent-shared/skills"
mkdir -p "$skills/herdr-stack" "$skills/herdr-stack-manifest"
"$checkout/target/release/herdr-stack" --skill >"$skills/herdr-stack/SKILL.md"
"$checkout/target/release/herdr-stack" --skill manifest >"$skills/herdr-stack-manifest/SKILL.md"
